        "text",
        "binary"
      ],
      "routable": false,
      "title": "Frame Type",
      "type": "string"
    },
    "payload_b64": {
      "$ref": "#/$defs/Base64Payload",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    }
  },
  "required": [
    "frame_type",
    "payload_b64"
  ],
  "title": "WebSocketMessage",
  "type": "object"
}
