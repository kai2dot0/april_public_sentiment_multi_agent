{
  "$defs": {
    "Identifier": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PositionDomain": {
      "additionalProperties": false,
      "description": "位置与排序域显式绑定来源、上游实例和游标语义版本。",
      "properties": {
        "cursor_semantics": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "ordering_domain": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "source_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "upstream_instance": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "source_id",
        "upstream_instance",
        "ordering_domain",
        "cursor_semantics"
      ],
      "title": "PositionDomain",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SourcePosition": {
      "additionalProperties": false,
      "description": "外部序号 / 时间 / 不透明游标均用字符串；禁止跨域直接比较。",
      "properties": {
        "domain": {
          "$ref": "#/$defs/PositionDomain",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "value": {
          "default_semantics": "required nonempty opaque cursor; preserve whitespace and exact UTF-8 text",
          "digest": "include",
          "minLength": 1,
          "routable": false,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "value"
      ],
      "title": "SourcePosition",
      "type": "object"
    },
    "StableReference": {
      "additionalProperties": false,
      "description": "逻辑对象稳定身份；不携带 blob 实例 ID 或可变治理属性。",
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/Sha256",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "object_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "version": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "object_id",
        "version",
        "content_digest"
      ],
      "title": "StableReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "确认追上实时必须给出依据；SDK / 平台仍须按钉定来源协议验证。",
  "properties": {
    "connection_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "evidence_ref": {
      "$ref": "#/$defs/StableReference",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "live_position": {
      "$ref": "#/$defs/SourcePosition",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    }
  },
  "required": [
    "connection_id",
    "live_position",
    "evidence_ref"
  ],
  "title": "CatchUpProof",
  "type": "object"
}
