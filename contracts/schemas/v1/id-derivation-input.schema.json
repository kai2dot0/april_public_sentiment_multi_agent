      "minimum": 1,
      "type": "integer"
    },
    "SafeCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "每种输出类型独立使用从零开始的局部索引，段号从一开始。",
  "properties": {
