    "output_kind": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "segment_no": {
      "$ref": "#/$defs/PositiveCount",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "task_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    }
  },
  "required": [
    "task_id",
    "segment_no",
    "output_kind",
    "local_output_index"
