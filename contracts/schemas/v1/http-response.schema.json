{
  "$defs": {
    "Base64Payload": {
      "type": "string"
    },
    "Header": {
      "additionalProperties": false,
      "description": "用有序数组保留重复头，不把 Set-Cookie 等重复字段静默折叠。",
      "properties": {
        "name": {
          "default_semantics": "required",
          "digest": "include",
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
          "routable": false,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "default_semantics": "required",
          "digest": "include",
          "routable": false,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Header",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "SDK 返回响应字节与不透明帧引用，不返回原始客户端或 socket。",
  "properties": {
    "frame_ref": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "headers": {
      "default_semantics": "required",
      "digest": "include",
      "items": {
        "$ref": "#/$defs/Header"
      },
      "routable": false,
      "title": "Headers",
      "type": "array"
    },
    "payload_b64": {
      "$ref": "#/$defs/Base64Payload",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "status_code": {
      "default_semantics": "required",
      "digest": "include",
      "maximum": 599,
      "minimum": 100,
      "routable": false,
      "title": "Status Code",
      "type": "integer"
    }
  },
  "required": [
    "status_code",
    "headers",
    "payload_b64",
    "frame_ref"
  ],
  "title": "HttpResponse",
  "type": "object"
}
