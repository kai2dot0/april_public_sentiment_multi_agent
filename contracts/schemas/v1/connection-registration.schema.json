{
  "$defs": {
    "Identifier": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "PositionDomain": {
      "additionalProperties": false,
      "description": "位置与排序域显式绑定来源、上游实例和游标语义版本。",
      "properties": {
        "cursor_semantics": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "ordering_domain": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "source_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "upstream_instance": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "source_id",
        "upstream_instance",
        "ordering_domain",
        "cursor_semantics"
      ],
      "title": "PositionDomain",
      "type": "object"
    },
    "SourcePosition": {
      "additionalProperties": false,
      "description": "外部序号 / 时间 / 不透明游标均用字符串；禁止跨域直接比较。",
      "properties": {
        "domain": {
          "$ref": "#/$defs/PositionDomain",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "value": {
          "default_semantics": "required nonempty opaque cursor; preserve whitespace and exact UTF-8 text",
          "digest": "include",
          "minLength": 1,
          "routable": false,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "value"
      ],
      "title": "SourcePosition",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "可信 SDK 在订阅前登记连接；请求游标不等于已被上游接受的起点。",
  "properties": {
    "binding_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "job_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "process_instance_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "requested_resume": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcePosition"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "default_semantics": "absent means no explicit resume cursor requested",
      "digest": "include",
      "routable": false
    },
    "source_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "upstream_instance": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    }
  },
  "required": [
    "binding_id",
    "source_id",
    "job_id",
    "process_instance_id",
    "upstream_instance"
  ],
  "title": "ConnectionRegistration",
  "type": "object"
}
