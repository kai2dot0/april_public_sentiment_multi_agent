{
  "$defs": {
    "DependencyFlags": {
      "additionalProperties": false,
      "description": "依赖事实沿链取并集；没有统一可信等级或人工复核自动洗白。",
      "properties": {
        "contains_ambiguous_reference": {
          "default": false,
          "default_semantics": "absent means no known ambiguous reference",
          "digest": "include",
          "routable": false,
          "title": "Contains Ambiguous Reference",
          "type": "boolean"
        },
        "contains_inferred_relation": {
          "default": false,
          "default_semantics": "absent means no known inferred relation",
          "digest": "include",
          "routable": false,
          "title": "Contains Inferred Relation",
          "type": "boolean"
        },
        "contains_simulated_input": {
          "default": false,
          "default_semantics": "absent means no known simulated input",
          "digest": "include",
          "routable": false,
          "title": "Contains Simulated Input",
          "type": "boolean"
        },
        "source_withdrawn": {
          "default": false,
          "default_semantics": "absent means no known source withdrawal; current read checks still apply",
          "digest": "include",
          "routable": false,
          "title": "Source Withdrawn",
          "type": "boolean"
        },
        "unverified_model_input": {
          "default": false,
          "default_semantics": "absent means this dependency flag is not established",
          "digest": "include",
          "routable": false,
          "title": "Unverified Model Input",
          "type": "boolean"
        }
      },
      "title": "DependencyFlags",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "SafeCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableReference": {
      "additionalProperties": false,
      "description": "逻辑对象稳定身份；不携带 blob 实例 ID 或可变治理属性。",
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/Sha256",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "object_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "version": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "object_id",
        "version",
        "content_digest"
      ],
      "title": "StableReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "首闭环只外发引用和责任元数据，不内联来源正文或原始响应。",
  "properties": {
    "configuration_ref": {
      "$ref": "#/$defs/StableReference",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "coverage_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "default_semantics": "absent when no coverage declaration was written",
      "digest": "include",
      "routable": false
    },
    "flags": {
      "$ref": "#/$defs/DependencyFlags",
      "default_semantics": "absent expands to no established dependency flags",
      "digest": "include",
      "routable": false
    },
    "job_generation": {
      "$ref": "#/$defs/SafeCount",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "job_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "page_result_ref": {
      "$ref": "#/$defs/StableReference",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "raw_refs": {
      "default_semantics": "required",
      "digest": "include",
      "items": {
        "$ref": "#/$defs/StableReference"
      },
      "routable": false,
      "title": "Raw Refs",
      "type": "array"
    },
    "source_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "task_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    }
  },
  "required": [
    "job_id",
    "job_generation",
    "task_id",
    "source_id",
    "page_result_ref",
    "configuration_ref",
    "raw_refs"
  ],
  "title": "CollectionPageData",
  "type": "object"
}
