{
  "$defs": {
    "Checkpoint": {
      "additionalProperties": false,
      "description": "连接器检查点；游标未知与缺省为空显式区分，不隐式恢复到 live。",
      "properties": {
        "authority_assignment_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveCount"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "default_semantics": "absent means no recorded authority assignment",
          "digest": "include",
          "routable": false
        },
        "connector_schema_version": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "continuous_receipt_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourcePosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "default_semantics": "absent means accepted resume cursor is unknown; never infer from first event",
          "digest": "include",
          "routable": false
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourcePosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "default_semantics": "absent means no known source position",
          "digest": "include",
          "routable": false
        },
        "state": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "default_semantics": "required",
          "digest": "include",
          "routable": false,
          "title": "State",
          "type": "object"
        }
      },
      "required": [
        "connector_schema_version",
        "state"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "DependencyFlags": {
      "additionalProperties": false,
      "description": "依赖事实沿链取并集；没有统一可信等级或人工复核自动洗白。",
      "properties": {
        "contains_ambiguous_reference": {
          "default": false,
          "default_semantics": "absent means no known ambiguous reference",
          "digest": "include",
          "routable": false,
          "title": "Contains Ambiguous Reference",
          "type": "boolean"
        },
        "contains_inferred_relation": {
          "default": false,
          "default_semantics": "absent means no known inferred relation",
          "digest": "include",
          "routable": false,
          "title": "Contains Inferred Relation",
          "type": "boolean"
        },
        "contains_simulated_input": {
          "default": false,
          "default_semantics": "absent means no known simulated input",
          "digest": "include",
          "routable": false,
          "title": "Contains Simulated Input",
          "type": "boolean"
        },
        "source_withdrawn": {
          "default": false,
          "default_semantics": "absent means no known source withdrawal; current read checks still apply",
          "digest": "include",
          "routable": false,
          "title": "Source Withdrawn",
          "type": "boolean"
        },
        "unverified_model_input": {
          "default": false,
          "default_semantics": "absent means this dependency flag is not established",
          "digest": "include",
          "routable": false,
          "title": "Unverified Model Input",
          "type": "boolean"
        }
      },
      "title": "DependencyFlags",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "JsonValue": {},
    "PositionDomain": {
      "additionalProperties": false,
      "description": "位置与排序域显式绑定来源、上游实例和游标语义版本。",
      "properties": {
        "cursor_semantics": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "ordering_domain": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "source_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "upstream_instance": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "source_id",
        "upstream_instance",
        "ordering_domain",
        "cursor_semantics"
      ],
      "title": "PositionDomain",
      "type": "object"
    },
    "PositiveCount": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "PublicationPolicy": {
      "enum": [
        "automatic",
        "manual_only"
      ],
      "type": "string"
    },
    "SafeCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "Sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SourcePosition": {
      "additionalProperties": false,
      "description": "外部序号 / 时间 / 不透明游标均用字符串；禁止跨域直接比较。",
      "properties": {
        "domain": {
          "$ref": "#/$defs/PositionDomain",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "value": {
          "default_semantics": "required nonempty opaque cursor; preserve whitespace and exact UTF-8 text",
          "digest": "include",
          "minLength": 1,
          "routable": false,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "value"
      ],
      "title": "SourcePosition",
      "type": "object"
    },
    "StableReference": {
      "additionalProperties": false,
      "description": "逻辑对象稳定身份；不携带 blob 实例 ID 或可变治理属性。",
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/Sha256",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "object_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "version": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "object_id",
        "version",
        "content_digest"
      ],
      "title": "StableReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "输入与强制标志 / 发布策略 / 优先级一起冻结，不能靠重试洗掉依赖。",
  "properties": {
    "checkpoint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Checkpoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "default_semantics": "absent means no captured job checkpoint",
      "digest": "include",
      "routable": false
    },
    "checkpoint_version": {
      "$ref": "#/$defs/SafeCount",
      "default": 0,
      "default_semantics": "absent means initial checkpoint version zero; authority is the job row",
      "digest": "include",
      "routable": false
    },
    "flags": {
      "$ref": "#/$defs/DependencyFlags",
      "default_semantics": "absent means no established inherited flags",
      "digest": "include",
      "routable": false
    },
    "inputs": {
      "default_semantics": "required",
      "digest": "include",
      "items": {
        "$ref": "#/$defs/StableReference"
      },
      "routable": false,
      "title": "Inputs",
      "type": "array"
    },
    "priority": {
      "default_semantics": "required",
      "digest": "include",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "routable": false,
      "title": "Priority",
      "type": "integer"
    },
    "publication_policy": {
      "$ref": "#/$defs/PublicationPolicy",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    }
  },
  "required": [
    "inputs",
    "publication_policy",
    "priority"
  ],
  "title": "InputSnapshot",
  "type": "object"
}
