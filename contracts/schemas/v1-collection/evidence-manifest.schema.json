{
  "$defs": {
    "ControlObjectRef": {
      "additionalProperties": false,
      "description": "完整控制身份；对象 ID 限键控 / 稳定身份，不能在此存原生作者明文。",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "object_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "scope": {
          "default_semantics": "required",
          "digest": "include",
          "enum": [
            "document",
            "account",
            "source"
          ],
          "routable": false,
          "title": "Scope",
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "tenant_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "tenant_id",
        "namespace",
        "source_id",
        "scope",
        "object_id"
      ],
      "title": "ControlObjectRef",
      "type": "object"
    },
    "DocumentIdentity": {
      "additionalProperties": false,
      "description": "稳定来源身份，原生 ID 含作者信息时使用按租户 / 来源的键控哈希。",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "native_id_hash": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "platform": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "namespace",
        "platform",
        "native_id_hash"
      ],
      "title": "DocumentIdentity",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "raw_response",
        "source_content",
        "model_output",
        "statistic",
        "rule_decision",
        "agent_intermediate"
      ],
      "type": "string"
    },
    "EvidenceOrigin": {
      "additionalProperties": false,
      "description": "来源与修订保持不可变；原生身份已由保管库按租户 / 来源派生。",
      "properties": {
        "document": {
          "$ref": "#/$defs/DocumentIdentity",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "revision": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "source_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "source_id",
        "document",
        "revision"
      ],
      "title": "EvidenceOrigin",
      "type": "object"
    },
    "EvidenceProducer": {
      "additionalProperties": false,
      "description": "必须由平台认证映射到此身份；载荷中的 role 不授予创建权限。",
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/Sha256",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "role": {
          "$ref": "#/$defs/ProducerRole",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "service_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "service_id",
        "role",
        "artifact_digest"
      ],
      "title": "EvidenceProducer",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "ProducerRole": {
      "enum": [
        "connector",
        "normalizer",
        "gateway",
        "runtime",
        "knowledge_service",
        "agent"
      ],
      "type": "string"
    },
    "RootSources": {
      "additionalProperties": false,
      "description": "普通内容写入根集合只含文档 / 账号；来源级记录走单独持锁断言。",
      "properties": {
        "objects": {
          "default_semantics": "absent expands to empty declared root set; runtime must independently resolve lineage",
          "digest": "include",
          "items": {
            "$ref": "#/$defs/ControlObjectRef"
          },
          "routable": false,
          "title": "Objects",
          "type": "array"
        }
      },
      "title": "RootSources",
      "type": "object"
    },
    "Sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableReference": {
      "additionalProperties": false,
      "description": "逻辑对象稳定身份；不携带 blob 实例 ID 或可变治理属性。",
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/Sha256",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "object_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "version": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "object_id",
        "version",
        "content_digest"
      ],
      "title": "StableReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "身份只含不可变出处，无 blob instance、分级、保留期或访问授权。",
  "properties": {
    "byte_digest": {
      "$ref": "#/$defs/Sha256",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "compliance_ref": {
      "$ref": "#/$defs/StableReference",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "kind": {
      "$ref": "#/$defs/EvidenceKind",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceOrigin"
        },
        {
          "type": "null"
        }
      ],
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "parents": {
      "default_semantics": "required",
      "digest": "include",
      "items": {
        "$ref": "#/$defs/StableReference"
      },
      "routable": false,
      "title": "Parents",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/EvidenceProducer",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "roots": {
      "$ref": "#/$defs/RootSources",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "default_semantics": "absent expands to evidence manifest 1.0.0",
      "digest": "include",
      "routable": false,
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "$ref": "#/$defs/Identifier",
      "default_semantics": "required",
      "digest": "include",
      "routable": false
    }
  },
  "required": [
    "tenant_id",
    "kind",
    "origin",
    "producer",
    "parents",
    "byte_digest",
    "compliance_ref",
    "roots"
  ],
  "title": "EvidenceManifest",
  "type": "object"
}
