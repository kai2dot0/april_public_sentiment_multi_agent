{
  "$defs": {
    "AvailabilityEntry": {
      "additionalProperties": false,
      "description": "禁读不等待扇出清理；未知 / 不支持不能返回 readable=true。",
      "properties": {
        "readable": {
          "default_semantics": "required",
          "digest": "include",
          "routable": false,
          "title": "Readable",
          "type": "boolean"
        },
        "reasons": {
          "default_semantics": "required",
          "digest": "include",
          "items": {
            "enum": [
              "permanently_withdrawn",
              "account_inactive",
              "sync_unverified",
              "source_gap",
              "document_unverified",
              "pending_withdrawal",
              "forbidden",
              "not_found",
              "unsupported"
            ],
            "type": "string"
          },
          "routable": false,
          "title": "Reasons",
          "type": "array"
        },
        "reference": {
          "$ref": "#/$defs/StableReference",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "reference",
        "readable",
        "reasons"
      ],
      "title": "AvailabilityEntry",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "Sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "StableReference": {
      "additionalProperties": false,
      "description": "逻辑对象稳定身份；不携带 blob 实例 ID 或可变治理属性。",
      "properties": {
        "content_digest": {
          "$ref": "#/$defs/Sha256",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "object_id": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        },
        "version": {
          "$ref": "#/$defs/Identifier",
          "default_semantics": "required",
          "digest": "include",
          "routable": false
        }
      },
      "required": [
        "object_id",
        "version",
        "content_digest"
      ],
      "title": "StableReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "结果只携带可用性元数据，无来源内容。",
  "properties": {
    "entries": {
      "default_semantics": "required",
      "digest": "include",
      "items": {
        "$ref": "#/$defs/AvailabilityEntry"
      },
      "routable": false,
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "entries"
  ],
  "title": "AvailabilityResult",
  "type": "object"
}
